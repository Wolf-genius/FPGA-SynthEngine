# Complete logical pin plan for P&R review, 2026-10-15.
# Based on the 31005 board photo, B's PMOD0 wiring and the reference 60K CST.
# Actual bank supplies, reset button and wiring must be checked before download.
IO_LOC "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC "rst_n" AA13;
IO_PORT "rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

# PMOD0 mapping confirmed by B. Verify actual bank voltage before download.
IO_LOC "adc_cs_n" R18;
IO_PORT "adc_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "adc_sclk" T18;
IO_PORT "adc_sclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "adc_mosi" P16;
IO_PORT "adc_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "adc_miso" R17;
IO_PORT "adc_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

# PMOD1 is reserved for A. Three adjacent GPIOs in the same silkscreen row:
# 3V3, GND, AA19, AA20, AB21, Y21. Use GPIO labels, not mirrored photo positions.
# Do not connect a DVP camera or another device to these shared signals.
IO_LOC "bclk" AA19;
IO_PORT "bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "ws" AA20;
IO_PORT "ws" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "din" AB21;
IO_PORT "din" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

# ST7735S actual wiring confirmed by user, BANK1, 3.3V logic.
IO_LOC "lcd_sck" C15;
IO_PORT "lcd_sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "lcd_sda" C14;
IO_PORT "lcd_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "lcd_cs_n" A14;
IO_PORT "lcd_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "lcd_rs" C13;
IO_PORT "lcd_rs" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "lcd_res_n" B13;
IO_PORT "lcd_res_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

# B KEY1/KEY2 reference: input-only, Bank9, 1.5V. Confirm 31005 button labels.
IO_LOC "key1_n" AB13;
IO_PORT "key1_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC "key2_n" Y12;
IO_PORT "key2_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

# JDY-31 and LED assignments from the two 2026-10-22/23 handoff packages.
IO_LOC "bt_rx" B15;
IO_PORT "bt_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "bt_tx" B16;
IO_PORT "bt_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led[0]" A16;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "led[1]" A15;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "led[2]" A20;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "led[3]" B20;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "led[4]" A21;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "led[5]" B21;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "led[6]" B18;
IO_PORT "led[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "led[7]" B17;
IO_PORT "led[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
